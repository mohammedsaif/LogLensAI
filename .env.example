# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_DB=loglens
POSTGRES_USER=loglens
POSTGRES_PASSWORD=change-me-local-only

# --- AI ---
# mock      = offline deterministic model (no key, nothing leaves your machine) - default
# anthropic = Claude via the Anthropic API (requires ANTHROPIC_API_KEY; billed per token)
# disabled  = deterministic summaries only
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_SERVER_FALLBACKS=true
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
EVIDENCE_TOKEN_BUDGET=6000

# --- Limits & retention ---
MAX_UPLOAD_MB=10
MAX_LINES=200000
RETENTION_DAYS=30
REDACT_IP_ADDRESSES=true

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080

# Local (non-Docker) backend default: sqlite:///./loglens.db
# DATABASE_URL=postgresql+psycopg://loglens:change-me-local-only@localhost:5432/loglens
