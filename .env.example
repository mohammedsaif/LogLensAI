# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_DB=loglens
POSTGRES_USER=loglens
POSTGRES_PASSWORD=change-me-local-only

# --- AI ---
# mock      = offline deterministic model (no key, nothing leaves your machine) - default
# anthropic = Claude (ANTHROPIC_API_KEY)
# openai    = OpenAI, or any OpenAI-compatible server via OPENAI_BASE_URL (Groq, OpenRouter, LM Studio, vLLM, ...)
# gemini    = Google Gemini (GEMINI_API_KEY)
# ollama    = local model via Ollama - logs never leave your machine/network
# disabled  = deterministic summaries only
# Cloud providers are billed per token by the provider; only the redacted evidence pack is sent.
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_SERVER_FALLBACKS=true

OPENAI_API_KEY=
# Required when AI_PROVIDER=openai. Use a current model name from your provider's docs.
OPENAI_MODEL=
# Leave empty for api.openai.com. Examples: http://localhost:1234/v1 (LM Studio), https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# json_schema (strict structured outputs) or json_object for servers without JSON-schema support
OPENAI_RESPONSE_FORMAT=json_schema

GEMINI_API_KEY=
# Required when AI_PROVIDER=gemini. Use a current model name from Google's docs.
GEMINI_MODEL=

# Ollama: run `ollama pull <model>` first. From Docker, the host is reachable as host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=16384
# Used by docker compose instead of OLLAMA_BASE_URL (the container reaches the host through host.docker.internal)
OLLAMA_DOCKER_URL=http://host.docker.internal:11434

# Local models on CPU can be slow: raise to 120-300 for Ollama.
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
EVIDENCE_TOKEN_BUDGET=6000

# --- Limits & retention ---
MAX_UPLOAD_MB=10
MAX_LINES=200000
RETENTION_DAYS=30
REDACT_IP_ADDRESSES=true

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080

# Local (non-Docker) backend default: sqlite:///./loglens.db
# DATABASE_URL=postgresql+psycopg://loglens:change-me-local-only@localhost:5432/loglens
